# Cronicle environment variables (copy to .env; never commit .env)

# HMS application endpoints
HMS_BASE_URL=https://your-hms-app.example.com
HMS_CRON_SECRET=replace-with-long-random-secret

# Timezone
TZ=Asia/Jakarta

# Cronicle notifications
CRONICLE_NOTIFICATION_EMAIL=admin@example.com

# SMTP (for Cronicle email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=notifications@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=noreply@example.com
SMTP_TO=admin@example.com

# Optional resource limits
# CRONICLE_MEMORY_LIMIT=512m
# CRONICLE_CPU_LIMIT=1.0
# CRONICLE_PIDS_LIMIT=256
