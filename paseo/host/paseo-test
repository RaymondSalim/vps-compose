#!/usr/bin/env bash
# Installed as /usr/local/bin/paseo-test. Usage: paseo-test path/to/compose.test.yml
# The Compose file must define a test service, and its disposable dependencies.
#
# Every service must declare a memory limit (mem_limit or deploy.resources.limits.memory),
# and the limits must sum to at most PASEO_TEST_MEM_BUDGET_MB. A container that exceeds its
# limit is OOM-killed immediately, which fails the run instead of letting the agent-tests
# slice sit above MemoryHigh and throttle every task in it, including the loop and flush
# kernel threads that back the rootless Docker data directory.
#
# Environment:
#   PASEO_TEST_TIMEOUT        seconds before `up` is terminated (default 900)
#   PASEO_TEST_MEM_BUDGET_MB  sum of per-service memory limits allowed (default 3072)
set -Eeuo pipefail
compose_file=${1:?Usage: paseo-test path/to/compose.test.yml}
[[ -f $compose_file ]] || { printf 'No such Compose file: %s\n' "$compose_file" >&2; exit 2; }

timeout_s=${PASEO_TEST_TIMEOUT:-900}
budget_mb=${PASEO_TEST_MEM_BUDGET_MB:-3072}
[[ $timeout_s =~ ^[1-9][0-9]*$ && $budget_mb =~ ^[1-9][0-9]*$ ]] || {
  printf 'PASEO_TEST_TIMEOUT and PASEO_TEST_MEM_BUDGET_MB must be positive integers.\n' >&2
  exit 2
}

# Pin the intended socket, ignoring inherited contexts or TLS configuration.
export DOCKER_HOST=unix:///run/agent-docker/docker.sock
unset DOCKER_CONTEXT DOCKER_TLS DOCKER_TLS_VERIFY DOCKER_CERT_PATH DOCKER_API_VERSION
security=$(docker info --format '{{json .SecurityOptions}}')
[[ $security == *rootless* ]] || { printf 'Expected rootless Docker; refusing to run.\n' >&2; exit 1; }

project="test-$(date +%s)-$(cat /proc/sys/kernel/random/uuid)"

# Rejects Compose files with an unbounded service or an oversized total before anything starts.
docker compose -f "$compose_file" -p "$project" config --format json |
  python3 -I -c '
import json, sys
budget = int(sys.argv[1]) * 1024 * 1024
total, missing = 0, []
for name, svc in json.load(sys.stdin)["services"].items():
    limit = svc.get("mem_limit") or (((svc.get("deploy") or {}).get("resources") or {}).get("limits") or {}).get("memory")
    if not limit:
        missing.append(name)
        continue
    total += int(limit) * int((svc.get("deploy") or {}).get("replicas") or 1)
if missing:
    sys.exit("Services without a memory limit: " + ", ".join(missing))
if total > budget:
    sys.exit("Memory limits total %d MiB, over the %d MiB budget." % (total >> 20, budget >> 20))
' "$budget_mb" || exit 2

up_pid=
signal_status=0
cleanup() {
  status=$?
  trap - EXIT
  if (( signal_status )); then status=$signal_status; fi
  # Bounded so a wedged daemon cannot hold the run open indefinitely.
  if ! timeout --kill-after=10 180 \
      docker compose -f "$compose_file" -p "$project" down --volumes --remove-orphans --rmi local; then
    printf 'Cleanup failed for project %s. Clean up that project explicitly.\n' "$project" >&2
    if (( status == 0 )); then status=1; fi
  fi
  exit "$status"
}
trap cleanup EXIT
# `up` runs in the background so a signal reaches this shell immediately instead of after `up` exits.
forward_signal() {
  signal_status=$1
  [[ -z $up_pid ]] || kill -TERM "$up_pid" 2>/dev/null || true
}
trap 'forward_signal 130' INT
trap 'forward_signal 143' TERM

printf 'Test project: %s (timeout %ss)\n' "$project" "$timeout_s"
timeout --kill-after=30 "$timeout_s" \
  docker compose -f "$compose_file" -p "$project" up \
    --build --abort-on-container-exit --exit-code-from test &
up_pid=$!
rc=0
wait "$up_pid" || rc=$?
# A trapped signal interrupts the first wait; the second collects the real exit status.
if (( signal_status )); then wait "$up_pid" 2>/dev/null || true; exit "$signal_status"; fi
if (( rc == 124 )); then printf 'Test run exceeded %ss and was terminated.\n' "$timeout_s" >&2; fi
exit "$rc"
