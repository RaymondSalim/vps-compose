# Paseo
PASEO_PASSWORD: "change-me"
PASEO_HOSTNAMES: "paseo.example.com,.lan"

# Git
GIT_CONFIG_GLOBAL: /home/paseo/.gitconfig


# Claude Code
CLAUDE_CODE_USE_BEDROCK=1
CLAUDE_CODE_USE_MANTLE=1
ANTHROPIC_MODEL="us.anthropic.claude-opus-5-5"
ANTHROPIC_SMALL_FAST_MODEL="us.anthropic.claude-sonnet-5-5"
CLAUDE_CODE_MAX_OUTPUT_TOKENS=32768
MAX_THINKING_TOKENS=8192

CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Container is on a bridge network, so point at the host, not localhost.
# A collector must actually be listening there; nothing in this repo runs one.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318

# AWS
AWS_PROFILE=bedrock
AWS_REGION=us-west-2
