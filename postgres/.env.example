# Non-secret configuration for postgres/docker-compose.yml
# Copy to .env and fill in values. Never commit .env.

# PostgreSQL container initialization (superuser for local admin only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-password
POSTGRES_DB=postgres

# Backup job target (use a least-privilege role; password goes in secrets/pgpass only)
BACKUP_USER=backup
BACKUP_DB=micasa-prod

# Backup schedule (cron format). Default: daily at 02:00 UTC
BACKUP_CRON=0 2 * * *

# Optional: cron mail recipient for backup job output
# CRON_MAILTO=admin@example.com

# S3 destination (enable bucket versioning or object lock outside this repo)
S3_BUCKET_NAME=your-bucket-name
AWS_DEFAULT_REGION=your-aws-region

# Secret file paths (gitignored). See secrets/README.md
PGPASS_SECRET_FILE=./secrets/pgpass
AWS_CREDENTIALS_SECRET_FILE=./secrets/aws_credentials

# Optional resource limits
# POSTGRES_MEMORY_LIMIT=768m
# POSTGRES_CPU_LIMIT=1.0
# POSTGRES_PIDS_LIMIT=200
# BACKUP_MEMORY_LIMIT=256m
# BACKUP_CPU_LIMIT=0.5
# BACKUP_PIDS_LIMIT=100
